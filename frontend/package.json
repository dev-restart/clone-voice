{
	"name": "frontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "svelte-kit sync && vite dev",
		"dev:5174": "svelte-kit sync && vite dev --host 127.0.0.1 --port 5174",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:regression": "playwright test tests/regression.spec.ts",
		"test:unit": "node --experimental-strip-types --test tests/production.test.ts tests/story-production.test.ts tests/voice-sample.test.ts tests/sound-projects.test.ts tests/generation-monitor.test.ts tests/models.test.ts",
		"test:e2e": "playwright test",
		"storybook": "storybook dev -p 6006 --no-open --disable-telemetry",
		"build-storybook": "storybook build --disable-telemetry"
	},
	"devDependencies": {
		"@playwright/test": "^1.59.1",
		"@storybook/addon-docs": "^10.6.3",
		"@storybook/addon-svelte-csf": "^5.1.5",
		"@storybook/sveltekit": "^10.6.3",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.2.2",
		"@types/node": "^25.6.0",
		"shadcn-svelte": "^1.7.1",
		"storybook": "^10.6.3",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"tailwindcss": "^4.2.2",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.2",
		"vite": "^8.0.7"
	},
	"packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
	"dependencies": {
		"@ffmpeg/ffmpeg": "^0.12.15",
		"@lucide/svelte": "^1.61.0",
		"bits-ui": "^2.20.2",
		"clsx": "^2.1.1",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"wavesurfer.js": "^7.12.6"
	}
}
