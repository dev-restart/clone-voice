CLONE_VOICE_STORAGE_DIR=storage
CLONE_VOICE_DATABASE_URL=
# 내려받은 모델(Hugging Face 캐시, Whisper)을 저장하는 위치. 기본은 backend/models 입니다.
CLONE_VOICE_MODELS_DIR=models
CLONE_VOICE_VOICE_DIR=
CLONE_VOICE_UPLOAD_DIR=
CLONE_VOICE_OUTPUT_DIR=
CLONE_VOICE_CONTENT_DIR=

# YouTube/Instagram 가져오기. cookie file은 로그인이 필요한 본인 소유 게시물에만 사용합니다.
CLONE_VOICE_MEDIA_IMPORT_COOKIE_FILE=
CLONE_VOICE_MEDIA_IMPORT_MAX_DURATION_SECONDS=3600

# /api/models와 사용자 화면에 노출할 runtime 목록입니다.
# "all" 또는 쉼표로 구분한 일부 항목을 사용합니다: voxcpm,soulx-singer,stable-audio-sfx
CLONE_VOICE_REGISTERED_MODELS=voxcpm,soulx-singer,stable-audio-sfx

CLONE_VOICE_VOXCPM_ENABLED=false
CLONE_VOICE_VOXCPM_MODEL_ID=openbmb/VoxCPM2
CLONE_VOICE_VOXCPM_DEVICE=auto
CLONE_VOICE_VOXCPM_LOAD_DENOISER=false
CLONE_VOICE_VOXCPM_OPTIMIZE=false
CLONE_VOICE_VOXCPM_CACHE_DIR=
CLONE_VOICE_VOXCPM_LOCAL_FILES_ONLY=false
CLONE_VOICE_VOXCPM_INFERENCE_TIMESTEPS=10
CLONE_VOICE_VOXCPM_MAX_LEN=4096

CLONE_VOICE_SOULX_SINGER_ENABLED=false
CLONE_VOICE_SOULX_SINGER_REPO_DIR=vendor/SoulX-Singer-MLX
CLONE_VOICE_SOULX_SINGER_PYTHON=
CLONE_VOICE_SOULX_SINGER_MODEL_DIR=models/SoulX-Singer-bf16
CLONE_VOICE_SOULX_SINGER_PREPROCESS_MODEL_DIR=pretrained_models/SoulX-Singer-Preprocess
CLONE_VOICE_SOULX_SINGER_WHISPER_MODEL_DIR=pretrained_models/openai__whisper-base
CLONE_VOICE_SOULX_SINGER_DEVICE=mps
CLONE_VOICE_SOULX_SINGER_STEPS=4
CLONE_VOICE_SOULX_SINGER_CFG_SCALE=2.0
CLONE_VOICE_SOULX_SINGER_SEPARATE_VOCALS=true
CLONE_VOICE_SOULX_SINGER_MIX_ACCOMPANIMENT=true
CLONE_VOICE_SOULX_SINGER_TIMEOUT_SECONDS=3600

CLONE_VOICE_STABLE_AUDIO_SFX_ENABLED=false
CLONE_VOICE_STABLE_AUDIO_REPO_DIR=vendor/stable-audio-3
CLONE_VOICE_STABLE_AUDIO_PYTHON=
CLONE_VOICE_STABLE_AUDIO_TIMEOUT_SECONDS=300

CLONE_VOICE_DEFAULT_TTS_MODEL=voxcpm
CLONE_VOICE_DEFAULT_VC_MODEL=soulx-singer
CLONE_VOICE_WHISPER_MODEL=base

CLONE_VOICE_LLM_BASE_URL=http://127.0.0.1:11434/v1
CLONE_VOICE_LLM_MODEL=qwen3:4b
CLONE_VOICE_LLM_API_KEY=ollama

# 로컬 전용이 기본입니다. 외부 API는 모델 설정 화면에서 별도로 선택합니다.
# NVIDIA API key는 Backend의 private 설정 파일에 저장되며 브라우저에 반환하지 않습니다.
